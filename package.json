{
  "name": "blackbox",
  "productName": "Blackbox",
  "version": "1.5.0",
  "description": "Run uncensored, abliterated AI models locally on your CPU. No cloud, no GPU, no guardrails.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": {
    "name": "Blackbox"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itriedcoding/locally-uncensored-ai.git"
  },
  "homepage": "https://github.com/itriedcoding/locally-uncensored-ai",
  "bugs": {
    "url": "https://github.com/itriedcoding/locally-uncensored-ai/issues"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/make-icon.mjs",
    "preflight": "node scripts/preflight.mjs",
    "prepare:win": "node scripts/prepare-win.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "dist": "npm run icon && electron-builder --win --publish never",
    "dist:dir": "npm run icon && electron-builder --win --dir --publish never",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:ide": "node scripts/smoke-ide.mjs",
    "verify:modes": "node scripts/verify-modes.mjs",
    "verify:hf": "node scripts/verify-hf.mjs"
  },
  "dependencies": {
    "@wllama/wllama": "^3.8.1",
    "node-llama-cpp": "^3.22.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.blackbox.local",
    "productName": "Blackbox",
    "copyright": "Copyright © 2026 Blackbox",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,LICENSE,license,*.map}",
      "!**/node_modules/@node-llama-cpp/{linux,darwin}-*/**",
      "!**/node_modules/@node-llama-cpp/win-arm64/**",
      "!**/*.ts",
      "!**/.cache/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**",
      "**/*.node",
      "**/*.dll",
      "**/*.so",
      "**/*.dylib",
      "**/*.exe",
      "**/resources/trainer/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Blackbox-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Blackbox"
    }
  },
  "files": [
    "electron/**/*",
    "renderer/**/*",
    "resources/**/*",
    "package.json",
    "node_modules/**/*",
    "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,LICENSE,license,*.map}",
    "!**/node_modules/@node-llama-cpp/{linux,darwin}-*/**",
    "!**/node_modules/@node-llama-cpp/win-arm64/**",
    "!**/*.ts",
    "!**/.cache/**"
  ]
}
